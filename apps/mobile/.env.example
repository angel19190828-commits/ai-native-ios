# Local Vercel dev server or deployed API. Do not put Gemini/provider keys here.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Local development only. Release checks reject this when true.
EXPO_PUBLIC_ALLOW_GUEST=true
# Public ingest DSN only. Never expose SENTRY_AUTH_TOKEN to the app bundle.
EXPO_PUBLIC_SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
