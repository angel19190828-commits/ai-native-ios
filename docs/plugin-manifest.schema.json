{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.example/schemas/plugin-manifest.v1.json",
  "title": "AI Native Capability Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "execution", "actions"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "execution": { "enum": ["ios-native", "android-native", "server"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "risk", "confirmation", "scopes", "inputSchema", "resultSchema", "idempotency"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "risk": { "enum": ["read", "write", "external-action", "destructive"] },
        "confirmation": { "enum": ["never", "once-per-plan", "every-attempt"] },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "inputSchema": { "type": "object" },
        "resultSchema": { "type": "object" },
        "idempotency": { "enum": ["required", "supported", "none"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    }
  }
}
